<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Loud.Technology.Codex.Cnj.Sdk</AssemblyName>
    <RootNamespace>Loud.Technology.Codex.Cnj.Sdk</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Label="NuGet">
    <PackageId>Codex.Cnj</PackageId>
    <Title>Codex CNJ .NET SDK</Title>
    <Description>Modern, strongly typed .NET SDK for the Codex CNJ Process API, generated from its Swagger specification with AutoSDK.</Description>
    <PackageTags>codex;cnj;pdpj;processo;judiciario;api;client;sdk;dotnet;openapi;autosdk</PackageTags>
    <PackageProjectUrl>https://github.com/loud-technology/loud-technology-codex-cnj-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/loud-technology/loud-technology-codex-cnj-sdk.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
</Project>
